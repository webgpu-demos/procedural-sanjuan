# dependencies and build output
node_modules/
dist/

# raw downloads (OSM, FEMA USA Structures, terrain tiles, the USGS lidar DEM: 5 GB for the municipality) - re-create with `npm run fetch`
data/raw/
data/preview/
*.part
# compiled tiles as they were before a tool changed them in place (tools/pipeline/clearroads.mjs keeps each file's copy)
data/tiles-backup/

# compiled city - re-create with `npm run compile`
public/tiles/
# CC0 textures - re-create with `node tools/assets/fetch_textures.mjs`
public/textures/
# USGS aerial photo tiles - re-create with `npm run fetch`
public/ortho/

# local settings and secrets
.env
.env.*
!.env.example
.claude/

# logs, caches, editors, operating system
*.log
npm-debug.log*
.vite/
.cache/
*.tsbuildinfo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# traffic simulation: Python environment and working files (re-create with npm run sim:setup / the sim scripts)
.venv-sim/
data/sim/
data/sim-archive/

# audio previews rendered for review
samples/

# camera moves rendered by tools/render/flythrough.mjs
data/renders/
